# 가상환경, 환경변수 제외
.venv
.env

# GEMINI 파일은 버전 관리 제외
GEMINI.md

# dataset, datas, models 폴더 안 내용물 제외 (폴더는 유지)
dataset/*
!dataset/.gitkeep
datas/*
!datas/.gitkeep
models/*
!models/.gitkeep
.gemini/*
# 클로드 마크다운
CLAUDE.md
.vscode/*
.claude/*

# django 제외할 파일
*.pyc
*.pyo
*.env
__pycache__/
*log
db.sqlite3, db.sqlite3-journal
*.sqlite3
/media/
local_settings.py
*.secret*
*secret*
.idea/
.DS_store
*.bak
*.swp

